+:root {
+  font-family: "DM Sans", sans-serif;
+  color: #eff2ef;
+  background: #0a0c0e;
+  font-synthesis: none;
+  text-rendering: optimizeLegibility;
+  -webkit-font-smoothing: antialiased;
+  --bg: #0a0c0e;
+  --panel: #111518;
+  --panel-raised: #151a1d;
+  --line: rgba(221, 235, 229, 0.09);
+  --line-strong: rgba(221, 235, 229, 0.15);
+  --text: #eff2ef;
+  --muted: #919b99;
+  --quiet: #697371;
+  --mint: #9be9c5;
+  --mint-deep: #14281f;
+  --mono: "DM Mono", monospace;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  min-width: 320px;
+  scroll-behavior: smooth;
+  background: var(--bg);
+}
+
+body {
+  min-width: 320px;
+  min-height: 100vh;
+  margin: 0;
+  background:
+    radial-gradient(ellipse at 48% -35%, rgba(63, 103, 85, 0.11), transparent 47%),
+    var(--bg);
+}
+
+button,
+input,
+textarea,
+select {
+  font: inherit;
+}
+
+button {
+  color: inherit;
+}
+
+button:focus-visible,
+a:focus-visible,
+input:focus-visible,
+textarea:focus-visible,
+select:focus-visible {
+  outline: 2px solid rgba(155, 233, 197, 0.78);
+  outline-offset: 3px;
+}
+
+button:disabled {
+  cursor: not-allowed !important;
+  opacity: 0.42;
+}
+
+a {
+  color: inherit;
+}
+
+.aura-app {
+  min-height: 100vh;
+}
+
+.topbar {
+  position: sticky;
+  z-index: 20;
+  top: 0;
