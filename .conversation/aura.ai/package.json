{
  "name": "aura-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @aura/web dev",
    "build:web": "pnpm --filter @aura/web build",
    "typecheck:web": "pnpm --filter @aura/web typecheck",
    "typecheck:shared": "pnpm --filter @aura/shared typecheck"
  }
}
