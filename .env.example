# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=scraper
MONGO_PASSWORD=scraper
MONGO_DB=content_scraper
MONGO_COLLECTION=posts
MONGO_USERS_COLLECTION=users
MONGO_INTERACTIONS_COLLECTION=interactions

# Full URI overrides host/port/user/password when set
# MONGO_URI=mongodb://scraper:scraper@localhost:27017/content_scraper?authSource=admin

# Scraper defaults
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=content-scraper/0.1 (+https://github.com/devrev/data)
REQUEST_DELAY_SECONDS=0.5
LOG_LEVEL=INFO

# LiteLLM / DevRev AI gateway — preferred for indexing LLM (facet extraction)
# Key: `security find-generic-password -s arcus-token -a $USER -w`
LITELLM_API_KEY=
LITELLM_API_BASE=https://ai-gateway.dev.devrev-eng.ai/v1
# gemini/* embeds use GEMINI_API_KEY directly (gateway chat key has no embed models)
LITELLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LITELLM_LLM_MODEL=openai/gemini-2.5-flash

# Gemini — embeddings + user-side inference (onboard / persona / rerank)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash
EMBEDDING_DIM=768
EMBED_CONCURRENCY=4
FACETS_ENABLED=true
EMBED_IMAGES=false

# Qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=posts

# Chunking
CHUNK_WORDS=300
CHUNK_OVERLAP_WORDS=40
MAX_CHUNKS_PER_POST=32
MIN_BODY_WORDS=40

# Query engine
FILTER_K=64
MMR_LAMBDA=0.85
AUTHOR_DIVERSITY_CAP=3
RECENCY_HALF_LIFE_DAYS=30
RECENCY_WEIGHT=0.1
NEGATIVE_PENALTY_SCALE=0.35

# Profile
INTEREST_CENTROID_K=6
PERSONA_REFRESH_EVERY=10
WEIGHT_VERSION=default_v1

# API (Python FastAPI)
API_HOST=0.0.0.0
API_PORT=8000

# Web BFF (Express api-server) → Python
RECOMMENDATION_API_URL=http://127.0.0.1:8000
# Vite → Express (aura-web dev proxy)
API_PROXY_TARGET=http://127.0.0.1:5001

# Google sign-in (OAuth client of type "Web application" in Google Cloud Console).
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Signs the account cookie. Generate with: openssl rand -hex 32
AURA_COOKIE_SECRET=
# Shared by the BFF and FastAPI for BFF-only routes (account linking). openssl rand -hex 32
AURA_INTERNAL_TOKEN=
